{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@frontend/ui-kit": [
        "./dev/ui-kit.ts"
      ],
      "@frontend/icon": [
        "./dev/iconPreview.tsx"
      ],
      "@frontend/tools": [
        "./dev/toolsPreview.ts"
      ]
    }
  },
  "include": [
    "src",
    "dev",
    ".storybook",
    "vite.preview.config.ts",
    "local-ui-kit/ui-kit/declare.d.ts"
  ]
}
